{
  "name": "qbitui",
  "version": "1.5.0",
  "private": true,
  "main": "electron/dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "electron:compile": "tsc --project electron/tsconfig.json",
    "electron:dev": "concurrently -k -s first \"next dev\" \"wait-on http://localhost:3000 && npm run electron:compile && electron .\"",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:dist": "npm run electron:build && electron-builder",
    "electron:dist:mac": "npm run electron:build && electron-builder --mac",
    "electron:dist:win": "npm run electron:build && electron-builder --win",
    "electron:dist:linux": "npm run electron:build && electron-builder --linux"
  },
  "build": {
    "appId": "com.qbitui.app",
    "productName": "qbitUI",
    "afterPack": "electron/afterpack.mjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/dist/**",
      "electron/icon.png",
      ".next/standalone/**",
      "!.next/standalone/.git"
    ],
    "icon": "electron/icon.png",
    "asarUnpack": [
      ".next/**",
      "node_modules/keytar/**"
    ],
    "mac": {
      "icon": "electron/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "qbitUI needs access to your local network to connect to qBittorrent instances running on other devices.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "BitTorrent Torrent File",
            "CFBundleTypeExtensions": [
              "torrent"
            ],
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner"
          }
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "magnet",
            "CFBundleURLSchemes": [
              "magnet"
            ]
          }
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/icon.png",
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "linux": {
      "icon": "electron/icon.png",
      "category": "Network",
      "maintainer": "qbitUI <qbitui@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent Torrent File",
        "description": "BitTorrent Torrent File",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "magnet",
        "schemes": [
          "magnet"
        ]
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "keytar": "^7.9.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
