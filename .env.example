# Required: Secret used to encrypt the session cookie (min 32 chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# Optional: Pre-fill the qBittorrent host URL on the login page
NEXT_PUBLIC_DEFAULT_HOST=http://localhost:8080

# Optional: default torrent metadata API used to list a magnet link's files
# before adding it.  qbitUI calls it as <url>?magnet=<magnet link> and expects
# {"name": "...", "files": [{"path": "...", "size": 123}]}.
# Users can override this in Settings → Torrent Metadata.
NEXT_PUBLIC_DEFAULT_METADATA_API=
